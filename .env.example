# ============================================================================
# VARIABLES DE ENTORNO - DATANOVA CRM
# ============================================================================
# Copia este archivo a .env y configura los valores reales
# NUNCA commits el archivo .env con valores reales

# ----------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (OBLIGATORIO EN PRODUCCIÓN)
# ----------------------------------------------------------------------------
# Opción 1: URL de conexión completa (recomendado para Vercel/Heroku)
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_base_datos
# Ejemplo: postgresql://postgres:tu_password@aws-us-east-1.rds.amazonaws.com:5432/datanova_db

# Opción 2: Vercel Postgres
POSTGRES_URL=postgresql://usuario:password@host:puerto/nombre_base_datos

# Opción 3: Parámetros individuales (alternativa)
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_NAME=datanova_db
# DB_PORT=5432

# ----------------------------------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ----------------------------------------------------------------------------
# CONFIGURACIÓN CORS (Orígenes permitidos)
# ----------------------------------------------------------------------------
# Separar por comas múltiples orígenes si es necesario
# En producción Vercel, usa tu dominio: https://tu-dominio.vercel.app
ALLOWED_ORIGINS=https://tu-dominio.vercel.app,http://localhost:3000

# ----------------------------------------------------------------------------
# CONFIGURACIÓN VERCEL (Automático en Vercel, solo para referencia)
# ----------------------------------------------------------------------------
# VERCEL=tu-dominio.vercel.app (automático)
# VERCEL_URL=tu-dominio.vercel.app (automático)

# ----------------------------------------------------------------------------
# ALMACENAMIENTO LOCAL (Solo para desarrollo local)
# ----------------------------------------------------------------------------
# FORCE_LOCAL_DB=true (forzar uso de JSON local en lugar de PostgreSQL)
# Úsalo solo para desarrollo sin PostgreSQL instalado
